if(callback!=undefined&&typeof(callback)=="function"){callback();}}else{if(response.ErrorMessages){let scrolled=false;for(const[key,value]of Object.entries(response.ErrorMessages)){THGCommon.InvalidInput($(form+" [name='"+key+"']")[0],value);if(!scrolled){$(form+" [name='"+key+"']")[0].scrollIntoView(true);$(form+" [name='"+key+"']")[0].focus();scrolled=true;}}}}}},error:function(objXml){console.error(objXml);},complete:function(){btnSubmit.removeClass('loading');setTimeout(function(){btnSubmit.prop('disabled',false);},300);}});})}}
class AjaxFormNew{constructor(form,callback){$(document).on('change keypress keyup blur',form+' input, '+form+' textarea, '+form+' select',function(){$(this).removeClass('error');$(this).parent().find('.select2 .error').removeClass('error');$(this).parent().find('.error').hide();});$(form).submit(function(e){e.preventDefault();var btnSubmit=$("button[type=submit]",this);$.ajax({cache:false,type:'POST',data:$(form).serializeObject(),url:$(form).attr('action'),beforeSend:function(){btnSubmit.prop('disabled',true);btnSubmit.addClass('loading');},success:function(response){if(response){if(response.Success){if(response.RedirectUrl){setLocation(response.RedirectUrl);}
if(callback!=undefined&&typeof(callback)=="function"){callback();}}else{if(response.Message!=''&&response.Message!=null){NotifyError(response.Message);}
if(response.ErrorMessages){let scrolled=false;for(const[key,value]of Object.entries(response.ErrorMessages)){THGCommon.InvalidInput($(form+" [name='"+key+"']")[0],value);if(!scrolled){$(form+" [name='"+key+"']")[0].scrollIntoView(true);$(form+" [name='"+key+"']")[0].focus();scrolled=true;}}}}}},error:function(objXml){console.error(objXml);},complete:function(){btnSubmit.removeClass('loading');setTimeout(function(){btnSubmit.prop('disabled',false);},300);}});})}}
class GoogleReCaptcha{constructor(form,action){grecaptcha.ready(function(){grecaptcha.execute("6LfX-QsnAAAAAOIiB-QrHzjBHuT5H0yVO6mccoi3",{action:action}).then(function(token){document.getElementById(form).value=token;hideRecaptcha();});});function hideRecaptcha(){const recaptcha=$(".grecaptcha-badge");if(recaptcha.length)return recaptcha.css({display:"none"});requestAnimationFrame(()=>this.hideRecaptcha());}}}
class TimePrameSelect{constructor(){debugger
var selectElement=document.getElementById('TimeSelected');var time_list=[];for(var i=0;i<selectElement.options.length;i++){time_list.push(selectElement.options[i].text);}
var current_time=new Date();var current_hour=current_time.getHours();var current_minute=current_time.getMinutes();var start_closest_time=null;var end_closest_time=null;for(var j=0;j<time_list.length;j++){var time_str=time_list[j];var time_prame=time_str.split('-');var start_time=time_prame[0];var start_time_parts=start_time.split(':');var start_hour=parseInt(start_time_parts[0]);var start_minute=parseInt(start_time_parts[1]);var end_time=time_prame[1];var end_time_parts=end_time.split(':');var end_hour=parseInt(end_time_parts[0]);var end_minute=parseInt(end_time_parts[1]);if((start_hour<current_hour||(start_hour===current_hour&&start_minute<current_minute))&&(end_hour>current_hour||(end_hour===current_hour&&end_minute>current_minute))){start_closest_time={hour:start_hour,minute:start_minute};end_closest_time={hour:end_hour,minute:end_minute};}}
if(start_closest_time!==null&&end_closest_time!==null){var start_closest_time_str=start_closest_time.hour.toString().padStart(2,'0')+':'+start_closest_time.minute.toString().padStart(2,'0');var end_closest_time_str=end_closest_time.hour.toString().padStart(2,'0')+':'+end_closest_time.minute.toString().padStart(2,'0');var selectElement=document.getElementById('TimeSelected');var timeToSelect=start_closest_time_str+'-'+end_closest_time_str;for(var i=0;i<selectElement.options.length;i++){var option=selectElement.options[i];if(option.text===timeToSelect){option.selected=true;break;}}}}}
class TimeSelect2{constructor(){debugger
var divElement=document.querySelector('div.times');var spanElements=0;if(divElement!=null){spanElements=divElement.querySelectorAll('span');}
var time_list=[];for(var i=0;i<spanElements.length;i++){var span=spanElements[i];time_list.push(span.textContent);}
var current_time=new Date();var current_hour=current_time.getHours();var current_minute=current_time.getMinutes();var start_closest_time=null;var end_closest_time=null;var closest_time=null;for(var j=0;j<time_list.length;j++){var time_str=time_list[j];if(time_str.includes('-')){var time_prame=time_str.split('-');var start_time=time_prame[0];var start_time_parts=start_time.split(':');var start_hour=parseInt(start_time_parts[0]);var start_minute=parseInt(start_time_parts[1]);var end_time=time_prame[1];var end_time_parts=end_time.split(':');var end_hour=parseInt(end_time_parts[0]);var end_minute=parseInt(end_time_parts[1]);if((start_hour<current_hour||(start_hour===current_hour&&start_minute<current_minute))&&(end_hour>current_hour||(end_hour===current_hour&&end_minute>current_minute))){start_closest_time={hour:start_hour,minute:start_minute};end_closest_time={hour:end_hour,minute:end_minute};}}}
if(start_closest_time!==null&&end_closest_time!==null){var start_closest_time_str=start_closest_time.hour.toString().padStart(2,'0')+':'+start_closest_time.minute.toString().padStart(2,'0');var end_closest_time_str=end_closest_time.hour.toString().padStart(2,'0')+':'+end_closest_time.minute.toString().padStart(2,'0');var timeToSelect=start_closest_time_str+'-'+end_closest_time_str;var divElement=document.querySelector('div.times');var spanElements=divElement.querySelectorAll('span');for(var i=0;i<spanElements.length;i++){var spanStart=spanElements[2];var inputStart=spanStart.previousElementSibling;var spanFind=spanElements[i];if(spanFind.textContent===timeToSelect){var input=spanFind.previousElementSibling;var inputdate=document.getElementById('appointmentDate').value;if(inputdate!=null){var inputValue=inputdate.replaceAll(' ','');}
var currentDate=new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'2-digit',year:'numeric'});if(inputValue===currentDate||inputdate===''||inputdate===null){input.checked=true;input.scrollIntoView({behavior:'smooth',block:'start',inline:'start'});console.log('sdasdsd')
setTimeout(function(){input.scrollIntoView({behavior:'smooth',block:'start',inline:'start'});},200);console.log('sdasdsdsdasdsd')}else{input.checked=false;console.log('đã thay đổi')
inputStart.scrollIntoView({behavior:'smooth',block:'start',inline:'start'});setTimeout(function(){inputStart.scrollIntoView({behavior:'smooth',block:'start',inline:'start'});},200);}}}}}}
class TimeSelect{constructor(){debugger
var selectElement=document.getElementById('TimeSelected');var time_list=[];for(var i=0;i<selectElement.options.length;i++){time_list.push(selectElement.options[i].text);}
var current_time=new Date();var current_hour=current_time.getHours();var current_minute=current_time.getMinutes();var closest_time=null;for(var j=0;j<time_list.length;j++){var time_str=time_list[j];var time_parts=time_str.split('h');var hour=parseInt(time_parts[0]);var minute=parseInt(time_parts[1]);if(hour>current_hour||(hour===current_hour&&minute>current_minute)){if(closest_time===null||hour<closest_time.hour||(hour===closest_time.hour&&minute<closest_time.minute)){closest_time={hour:hour,minute:minute};}}}
if(closest_time!==null){var closest_time_str=closest_time.hour.toString().padStart(2,'0')+'h'+closest_time.minute.toString().padStart(2,'0');var selectElement=document.getElementById('TimeSelected');var timeToSelect=closest_time_str;for(var i=0;i<selectElement.options.length;i++){var option=selectElement.options[i];if(option.text===timeToSelect){option.selected=true;break;}}}}}
$('#appointmentDate').on('change keypress keyup blur',function(){console.log('thaydoi');new TimeSelect2();});class THGCommon{constructor(options){window.setLocation=function(url){window.location.href=url;};}
static InvalidInput(elm,message){if(elm==undefined){return;}
let parent=$(elm).parent();let errId=`#${elm.id}-error`;if($(elm)&&!$(elm).hasClass('error')){$(elm).addClass('error');let elmName=$(elm).attr('name');let select2=$(`#select2-${elmName}-container`);if($(select2).length&&!$(select2).hasClass('error')){$(select2).addClass('error');}}
if(!$(parent).find(errId).length){parent.append(`<div id="${elm.id}-error" class="error">${message}</div>`);}
else{$(errId).text(message);}
$(errId).show();}}
(function($,window,document){new THGCommon();})(jQuery,this,document);function resizeIframe(obj){obj.style.height=0;obj.style.height=obj.contentWindow.document.body.scrollHeight+'px';};
function bindDataSelect2(el,data,selectedvalues){$(el).empty();$(el).select2({data:$.map(data,function(obj){return{id:obj.id,text:obj.text}}),minimumResultsForSearch:0,allowClear:true,closeOnSelect:true});if(typeof selectedvalues!=='undefined'&&selectedvalues!==false){$(el).val(selectedvalues).change();}};
$.fn.serializeObject=function(){let o={};this.serializeArray().map(obj=>{o[obj.name]=obj.value||'';});return o;};;
class JanCommon{constructor(options){window.setLocation=function(url){window.location.href=url;};}
static InvalidInput(elm,message){let parent=$(elm).parent();let errId=`#${elm.id}-error`;if($(elm)&&!$(elm).hasClass('error')){$(elm).addClass('error');let elmName=$(elm).attr('name');let select2=$(`#select2-${elmName}-container`);if($(select2).length&&!$(select2).hasClass('error')){$(select2).addClass('error');}}
console.log("errId",errId);console.log("$(errId).length",$(errId).length);if(!$(parent).find(errId).length){parent.append(`<div id="${elm.id}-error" class="error">${message}</div>`);}
else{$(errId).text(message);}
$(errId).show();}}
(function($,window,document){new JanCommon();})(jQuery,this,document);;
class AuthLogin{constructor(loginElement){$(document).on('change keypress keyup blur',loginElement+' input, '+loginElement+' textarea, '+loginElement+' select',function(){$(this).removeClass('error');$(this).parent().find('.select2 .error').removeClass('error');$(this).parent().find('.error').hide();});$(loginElement).submit(function(e){e.preventDefault();var btnSubmit=$("button[type=submit]",this);$.ajax({cache:false,type:'POST',data:$(loginElement).serializeObject(),url:$(loginElement).attr('action'),beforeSend:function(){btnSubmit.prop('disabled',true);btnSubmit.addClass('loading');},success:function(response){$("#rfvCaptchaL").hide();if(response){if(response.Success&&response.ReturnUrl){setLocation(response.ReturnUrl);}
if(!response.Success){if(response.LoginFailOn){for(const[key,value]of Object.entries(response.LoginFailOn)){THGCommon.InvalidInput($(loginElement+" [name='"+key+"']")[0],value);}}
if(response.Message==="FailCaptcha"){$("#rfvCaptchaL").html("Captcha không hợp lệ");$("#rfvCaptchaL").show();}
grecaptcha.reset();}}},error:function(objXml){console.error(objXml);},complete:function(){btnSubmit.prop('disabled',false);btnSubmit.removeClass('loading');}});})}}
class AuthRegister{constructor(registerElement){$(document).on('change keypress keyup blur',registerElement+' input, '+registerElement+' textarea, '+registerElement+' select'+registerElement+' button',function(){$(this).removeClass('error');$(this).parent().find('.select2 .error').removeClass('error');$(this).parent().find('.error').hide();});$(document).on('change keypress key','.form-control.inputOTP',function(){$(`#invalidOTP`).text('');});$(registerElement).unbind('submit').submit(function(e){var objData=$(registerElement).serializeObject();var otpType=document.getElementById('typeOTP').value;if(otpType=='OTP_Register'||otpType=='OTP_Forgot_Password'){var numCharOtp=$('#numCharOtp').val();if(numCharOtp!=null){let otp=$("#divOTP input").sort(function(a,b){return parseInt($(b).attr('data-index'))<parseInt($(a).attr('data-index'))?1:-1;}).map(function(){return $(this).val()}).get().join('');objData={'accountName':$('#userForgot').val(),'otp':otp,'type':otpType,'check':'phoneregister'};}}
if(otpType=='OTP_ChangeEmail'){var numCharOtp=$('#numCharOtp').val();if(numCharOtp!=null){let otp=$("#divOTP input").sort(function(a,b){return parseInt($(b).attr('data-index'))<parseInt($(a).attr('data-index'))?1:-1;}).map(function(){return $(this).val()}).get().join('');objData={'accountName':$('#userForgot').val(),'otp':otp,'email':$('#userForgot').val(),'check':'emailchange'};}}
if(otpType=='OTP_PhoneInfo'){var customerForm=$("#formInfoCustomer").serializeObject();var numCharOtp=$('#numCharOtp').val();if(numCharOtp!=null){let otp=$("#divOTP input").sort(function(a,b){return parseInt($(b).attr('data-index'))<parseInt($(a).attr('data-index'))?1:-1;}).map(function(){return $(this).val()}).get().join('');objData={'accountName':$('#userForgot').val(),'otp':otp,'email':$('#userForgot').val(),'check':'phoneinfo','customerForm':customerForm};}}
e.preventDefault();var btnSubmit=$("button[type=submit]",this);$.ajax({cache:false,type:'POST',data:objData,url:$(registerElement).attr('action'),beforeSend:function(){btnSubmit.prop('disabled',true);btnSubmit.addClass('loading');},success:function(response){if(response){$("#rfvCaptchaRes").hide();if(response.Success){$('#divOTP').text('');$('#titleHeadConfirmOTP').text('');document.getElementById('typeOTP').value='';if(registerElement=='#auth-register'){$('#myRegister').modal('hide');$('#typeOTP').val('OTP_Register');$('#numCharOtp').val(response.Result.numOtp);for(var i=0;i<response.Result.numOtp;i++){if(i==0)
$('#divOTP').append(`<div class="control"><input type="text" class="form-control active inputOTP" data-index='${i}' maxlength='1'/></div>`);else
$('#divOTP').append(`<div class="control"><input type="text" class="form-control inputOTP" data-index='${i}' maxlength='1'/></div>`);}
AuthRegister.initEventOtp();$('#confirmOTP').modal({function:JanAuth.TimeDown(response.Result.timeDownOTP,response.Result.tempOTP,response.Result.cId,response.Result.issfor,response.Result.Password),backdrop:'static',keyboard:true});var user=$(registerElement).serializeObject()['PhoneOrEmail'];$('#userForgot').val(user);if($.isNumeric(user)){$('#PhoneRegis').val(user);$('#lastPhone').text('*'+user.substring(user.length-4));}
JanAuth.getTitleHeadConfirmOTP(user);}
else if(registerElement=='#valid-phoneOrEmail'){$('#validPhoneOrEmail').modal('hide');$('#numCharOtp').val(response.Result.numOtp);for(var i=0;i<response.Result.numOtp;i++){if(i==0)
$('#divOTP').append(`<div class="control"><input type="text" class="form-control active inputOTP" data-index='${i}' maxlength='1'/></div>`);else
$('#divOTP').append(`<div class="control"><input type="text" class="form-control inputOTP" data-index='${i}' maxlength='1'/></div>`);}
AuthRegister.initEventOtp();$('#confirmOTP').modal({function:JanAuth.TimeDown(response.Result.timeDownOTP,response.Result.tempOTP,response.Result.cId,response.Result.issfor,""),backdrop:'static',keyboard:true});$('#typeOTP').val('OTP_Forgot_Password');var user=$(registerElement).serializeObject()['PhoneOrEmail'];$('#userForgot').user;JanAuth.getTitleHeadConfirmOTP(user);}
else if(otpType=='OTP_Forgot_Password'){$('#confirmOTP').modal('hide');$('#changedPassword').modal({backdrop:'static',keyboard:true});}
else if(registerElement=='#changed-password'){$('#changedPassword').modal('hide');$('#accountStatus').text('Đổi mật khẩu thành công');$('#updateProfile').modal('hide');$('#redirectHome').hide();$('#changpasssucess').modal({backdrop:'static',keyboard:true});}
else if(registerElement=='#auth-change-email'){$('#changeEmailModal').modal('hide');$('#typeOTP').val('OTP_ChangeEmail');$('#numCharOtp').val(response.Result.numOtp);for(var i=0;i<response.Result.numOtp;i++){if(i==0)
$('#divOTP').append(`<div class="control"><input type="text" class="form-control active inputOTP" data-index='${i}' maxlength='1'/></div>`);else
$('#divOTP').append(`<div class="control"><input type="text" class="form-control inputOTP" data-index='${i}' maxlength='1'/></div>`);}
AuthRegister.initEventOtp();$('#confirmOTP').modal({function:JanAuth.TimeDown(response.Result.timeDownOTP,response.Result.tempOTP,response.Result.cId,response.Result.issfor,""),backdrop:'static',keyboard:true});var user=$(registerElement).serializeObject()['Email'];$('#userForgot').val(user);if($.isNumeric(user)){$('#PhoneRegis').val(user);$('#lastPhone').text('*'+user.substring(user.length-4));}
JanAuth.getTitleHeadConfirmOTP(user);}
else if(otpType=='OTP_ChangeEmail'){$.ajax({type:"POST",url:"/logout"});$('#changeEmailSuccessModal').modal({backdrop:'static',keyboard:true});$('#confirmOTP').modal('hide');}
else if(response.Message=='InfoSuccess'){NotifySuccess("Bạn đã cập nhật thông tin thành công",function(){location.reload();});}
else if(response.Message=='PhoneSuccess'){location.reload();$('#confirmOTP').modal('hide');NotifySuccess("Bạn đã cập nhật thông tin thành công");}
else if(response.Message=='Phone'){$('#typeOTP').val('OTP_PhoneInfo');$('#invalidOTP').text('');$('.inputOTP').val('');$('#numCharOtp').val(response.Result.numOtp);for(var i=0;i<response.Result.numOtp;i++){if(i==0)
$('#divOTP').append(`<div class="control"><input type="text" class="form-control active inputOTP" data-index='${i}' maxlength='1'/></div>`);else
$('#divOTP').append(`<div class="control"><input type="text" class="form-control inputOTP" data-index='${i}' maxlength='1'/></div>`);}
AuthRegister.initEventOtp();$('#confirmOTP').modal({function:JanAuth.TimeDown(response.Result.timeDownOTP,response.Result.tempOTP,response.Result.cId,response.Result.issfor,""),backdrop:'static',keyboard:true});var user=$(registerElement).serializeObject()['Phone'];JanAuth.getTitleHeadConfirmOTP(user);}
else{$('#confirmOTP').modal('hide');$('#accountStatus').text('Đăng ký tài khoản thành công');$('#redirectHome').hide();$('#myRegisterSuccess').modal({backdrop:'static',keyboard:true});}}
else if(response.RegisterFailOn){for(const[key,value]of Object.entries(response.RegisterFailOn)){THGCommon.InvalidInput($(registerElement+" [name='"+key+"']")[0],value);$(`#${key}`).text(value);}
grecaptcha.reset();}
else if(!response.Success&&response.Message=="FailCaptcha"){$("#rfvCaptchaRes").html("Captcha không hợp lệ");$("#rfvCaptchaRes").show();grecaptcha.reset();}}},error:function(objXml){console.error(objXml);},complete:function(){btnSubmit.prop('disabled',false);btnSubmit.removeClass('loading');}});});}
static initEventOtp(){$('#divOTP input').unbind("keydown");$('#divOTP input').keyup(function(){console.log($(this).val());if($(this).val()){let next=$(this).attr('data-index');$(`#divOTP input[data-index="${++next}"]`).focus();$('#divOTP input').removeClass('active');$(`#divOTP input[data-index="${next}"]`).addClass('active');}});}}
class CustomerProfile{constructor(cusProfileElement){if(jQuery('input.date').length){$('input.date').datetimepicker({format:'LT',format:'DD / MM / YYYY'});}
$(document).on('change keypress keyup blur',cusProfileElement+' input, '+cusProfileElement+' textarea, '+cusProfileElement+' select',function(){$(this).removeClass('error');$(this).parent().find('.select2 .error').removeClass('error');$(this).parent().find('.error').hide();});$(function(){var countryId=230;$('#StateProvince').find('option').remove();$.ajax({type:'GET',url:'/auth/GetStatesByCountryId',data:{'countryId':countryId},success:function(response){$.each(response,function(key,value){$('#StateProvince').append(`<option value='${value.id}'>${value.text}</option>`);});},error:function(objXml){if(objXml!=null&&objXml.responseText!=null&&objXml.responseText!==''){displayNotification(objXml.responseText,'error');}}});$(document).on('change','#StateProvince',function(e){e.preventDefault();var provinceId=$('#StateProvince').val();$('#District').find('option').remove();$.ajax({type:'GET',url:'service/GetWardsByProvinceId',data:{'provinceId':provinceId},success:function(response){$.each(response,function(index,value){$('#District').append(`<option value='${value.id}'>${value.text}</option>`);});},error:function(objXml){if(objXml!=null&&objXml.responseText!=null&&objXml.responseText!==''){displayNotification(objXml.responseText,'error');}}});});$(document).on('change','#District',function(e){e.preventDefault();var provinceId=$('#StateProvince').val();$('#Ward').find('option').remove();$.ajax({type:'GET',url:'service/GetWardsByProvinceId',data:{'provinceId':provinceId},success:function(response){$.each(response,function(index,value){$('#Ward').append(`<option value='${value.id}'>${value.text}</option>`);});},error:function(objXml){if(objXml!=null&&objXml.responseText!=null&&objXml.responseText!==''){displayNotification(objXml.responseText,'error');}}});});});$(cusProfileElement).submit(function(e){e.preventDefault();var btnSubmit=$("button[type=submit]",this);$.ajax({cache:false,type:'POST',data:$(cusProfileElement).serializeObject(),url:$(cusProfileElement).attr('action'),beforeSend:function(){btnSubmit.prop('disabled',true);btnSubmit.addClass('loading');},success:function(response){if(response){if(response.Success){$('#customerProfile').modal('hide');$('#accountStatus').text('Cập nhật thông tin cá nhân thành công');$('#redirectHome').show();$('#updateProfile').hide();$('#updateProfile').modal("hide");$('#myRegisterSuccess').modal({backdrop:'static',keyboard:true});}
if(!response.Success&&response.RegisterFailOn){for(const[key,value]of Object.entries(response.RegisterFailOn)){THGCommon.InvalidInput($(cusProfileElement+" [name='"+key+"']")[0],value);}}}},error:function(objXml){console.error(objXml);},complete:function(){btnSubmit.prop('disabled',false);btnSubmit.removeClass('loading');}});})}}
class JanAuth{static TimeDown(time,tempOTP,cId,issfor,pass){var timeout=null;timeout=setInterval(function(){time--;var title=document.getElementById('down-time');title.innerHTML=time<10?'00:0'+time:'00:'+time;if(time==0){clearInterval(timeout);title.innerHTML=`<a href='#' class='ReSendOTP' data-url="/Auth/ReSendOTP?tempOTP=${tempOTP}&cid=${cId}&issfor=${issfor}&pass=${pass}">Gửi lại </a>`;$('#down-time a.ReSendOTP').unbind("click");$('#down-time a.ReSendOTP').click(function(e){$(`#invalidOTP`).text('');$(".inputOTP").val('');$('#userForgot').val(issfor);e.preventDefault();$.ajax({cache:false,type:'GET',url:$(this).attr('data-url'),success:function(response){if(response){if(response.Success&&response.Result.timeDownOTP&&response.Result.tempOTP){JanAuth.TimeDown(response.Result.timeDownOTP,response.Result.tempOTP,response.Result.cId,response.Result.issfor,response.Result.Password);}
console.error(response);}
else if(response.RegisterFailOn){for(const[key,value]of Object.entries(response.RegisterFailOn)){THGCommon.InvalidInput($("#auth-otp"+" [name='"+key+"']")[0],value);$(`#${key}`).text(value);}}},error:function(objXml){console.error(objXml);}});})}},1000);}
static forgotPassword(){$('#myLogin').modal('hide');$('#validPhoneOrEmail').modal({backdrop:'static',keyboard:true});}
static updateProfile(){$('#myRegisterSuccess').modal('hide');var phone=document.getElementById('PhoneRegis').value;if(phone!=null&&phone!=''){document.getElementById('Phone').value=phone;}
setTimeout(function(){$('#customerProfile').modal("show");console.log('show customerProfile modal');$('body').addClass("modal-open");},500);}
static openLogin(){$('.modal').modal('hide');$('#myLogin').modal({backdrop:'static',keyboard:true});}
static openRegister(){$('#myLogin').modal('hide');$('#myRegister').modal({backdrop:'static',keyboard:true});}
static getTitleHeadConfirmOTP(user){if($.isNumeric(user)){$('#titleHeadConfirmOTP').append(`<h4 class="modal-title">Xác thực số điện thoại</h4>

                    <div class="text-center note">

                    

                        Mã xác thực đã được gửi đến số điện thoại đuôi <span style="color: #1D93E3;">*${user.substring(user.length - 4)}</span> của bạn. Nhập mã xác thực 4 số để tiếp tục.

                    </div>`);}else{if(user){let email=user.replace(/(?<=[\w]{1})[\w-\._\+%]*(?=[\w]{1}@)/g,(x)=>'*'.repeat(x.length));$('#titleHeadConfirmOTP').append(`<h4 class="modal-title">Xác thực bằng email</h4>

                    <div class="text-center note">

                    

